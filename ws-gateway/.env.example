# Copy to .env on the VPS and fill in the values.

# Port the gateway listens on (Nginx proxies 443 → this)
PORT=3001

# MUST equal the app's GATEWAY_JWT_SECRET (the one used to sign tokens from
# /api/realtime/token). Invalid tokens → connections refused.
JWT_SECRET=

# MUST equal the app's REALTIME_API_KEY (used by lib/realtime/emit.ts to
# POST /emit). Generate e.g.: openssl rand -base64 36
API_KEY=

# Comma-separated browser origins allowed to connect.
ALLOWED_ORIGINS=http://localhost:3000,https://mktimothy.com,https://www.mktimothy.com
